---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'privacy');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-neutral-900 dark:text-neutral-100 mb-4">
        {page.data.heading}
      </h1>
      <p class="text-xl text-neutral-600 dark:text-neutral-400 mb-12">
        {page.data.subtitle}
      </p>

      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>

      <p class="mt-12 text-sm text-neutral-500 dark:text-neutral-400">
        Last updated: {page.data.lastUpdated}
      </p>
    </div>
  </section>
</BaseLayout>
