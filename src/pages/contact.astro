---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'contact');
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-neutral-900 dark:text-neutral-100 mb-4">
        {page.data.heading}
      </h1>
      <p class="text-xl text-neutral-600 dark:text-neutral-400 mb-12">
        {page.data.subtitle}
      </p>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact options -->
        <div class="space-y-8">
          <div>
            <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">
              {page.data.options.call.heading}
            </h2>
            <p class="text-neutral-600 dark:text-neutral-400 mb-4">
              {page.data.options.call.description}
            </p>
            <a
              href={page.data.options.call.href}
              class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded-lg bg-accent-600 text-white hover:bg-accent-700 transition-colors"
            >
              {page.data.options.call.label}
            </a>
          </div>

          {site.email && (
            <div>
              <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">
                {page.data.options.email.heading}
              </h2>
              <p class="text-neutral-600 dark:text-neutral-400 mb-2">
                {page.data.options.email.description}
              </p>
              <a
                href={`mailto:${site.email}`}
                class="text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300"
              >
                {site.email}
              </a>
            </div>
          )}

          <div>
            <h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-2">
              {page.data.options.linkedin.heading}
            </h2>
            <p class="text-neutral-600 dark:text-neutral-400 mb-2">
              {page.data.options.linkedin.description}
            </p>
            <a
              href={site.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              {page.data.options.linkedin.label}
            </a>
          </div>

          <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800">
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              Based in {site.location}, working with clients across the UK.
            </p>
          </div>
        </div>

        <!-- Contact form -->
        <div>
          <form
            id="contact-form"
            action="https://forms.mp-consulting.services/submit-form"
            method="POST"
            class="space-y-6"
          >
            <div>
              <label for="name" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">
                {page.data.form.fields.name}
              </label>
              <input
                type="text"
                name="name"
                id="name"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-none transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">
                {page.data.form.fields.email}
              </label>
              <input
                type="email"
                name="email"
                id="email"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-none transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">
                {page.data.form.fields.message}
              </label>
              <textarea
                name="message"
                id="message"
                rows="4"
                required
                class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-none transition-colors resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="contact-submit"
              class="w-full px-6 py-3 text-base font-medium rounded-lg bg-accent-600 text-white hover:bg-accent-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
            >
              {page.data.form.submit}
            </button>

            <p id="contact-status" class="text-sm hidden" role="status" aria-live="polite"></p>
          </form>
          <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
            {page.data.form.privacy}
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('contact-status') as HTMLParagraphElement | null;
    const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
    if (form && status && submit) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        submit.disabled = true;
        status.className = 'text-sm text-neutral-500 dark:text-neutral-400';
        status.textContent = 'Sending…';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
          });
          if (response.ok) {
            status.className = 'text-sm text-green-600 dark:text-green-400';
            status.textContent = 'Message sent — I’ll get back to you within a day.';
            form.reset();
          } else {
            status.className = 'text-sm text-red-600 dark:text-red-400';
            status.textContent = 'Something went wrong. Please try again or email instead.';
          }
        } catch (err) {
          console.error(err);
          status.className = 'text-sm text-red-600 dark:text-red-400';
          status.textContent = 'Something went wrong. Please try again or email instead.';
        } finally {
          submit.disabled = false;
        }
      });
    }
  </script>
</BaseLayout>
