---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'work');

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((study) => ({
    params: { id: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout title={study.data.title} description={`Case study: ${study.data.client} - ${study.data.industry}`}>
  <article class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-12">
        {study.data.website ? (
          <a
            href={study.data.website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 mb-4 no-underline group"
          >
            {study.data.logo && (
              <img
                src={study.data.logo}
                alt={`${study.data.client} logo`}
                class="w-10 h-10 rounded-lg object-cover flex-shrink-0"
              />
            )}
            <div class="leading-tight">
              <p class="font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-accent-600 dark:group-hover:text-accent-400">{study.data.client}</p>
              <p class="text-sm text-accent-600 dark:text-accent-400">{study.data.industry}</p>
            </div>
          </a>
        ) : (
          <div class="flex items-center gap-3 mb-4">
            {study.data.logo && (
              <img
                src={study.data.logo}
                alt={`${study.data.client} logo`}
                class="w-10 h-10 rounded-lg object-cover flex-shrink-0"
              />
            )}
            <div class="leading-tight">
              <p class="font-semibold text-neutral-900 dark:text-neutral-100">{study.data.client}</p>
              <p class="text-sm text-accent-600 dark:text-accent-400">{study.data.industry}</p>
            </div>
          </div>
        )}
        <h1 class="text-neutral-900 dark:text-neutral-100 mb-4">
          {study.data.title}
        </h1>
        <div class="flex flex-wrap gap-2">
          {study.data.services.map((service: string) => (
            <span class="px-3 py-1 text-sm font-medium rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
              {service}
            </span>
          ))}
        </div>
      </header>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mb-12 p-6 rounded-xl bg-neutral-100 dark:bg-neutral-900">
        {study.data.stats.map((stat: { value: string; label: string }) => (
          <div class="text-center">
            <div class="text-2xl md:text-3xl font-bold text-accent-600 dark:text-accent-400">{stat.value}</div>
            <div class="text-sm text-neutral-600 dark:text-neutral-400">{stat.label}</div>
          </div>
        ))}
      </div>

      <!-- Content -->
      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>

      {study.data.testimonial && (
        <blockquote class="my-12 py-8 px-8 border-l-4 border-accent-500 bg-neutral-100 dark:bg-neutral-900 rounded-r-xl">
          <p class="text-xl md:text-2xl font-medium text-neutral-800 dark:text-neutral-200 leading-relaxed mb-4">
            "{study.data.testimonial.quote}"
          </p>
          <cite class="text-sm font-medium text-accent-600 dark:text-accent-400 not-italic">
            — {study.data.testimonial.attribution}
          </cite>
        </blockquote>
      )}

      <!-- CTA -->
      <div class="mt-12 pt-12 border-t border-neutral-200 dark:border-neutral-800">
        <h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 mb-4">
          {page.data.detailCta.heading}
        </h2>
        <p class="text-neutral-600 dark:text-neutral-400 mb-6">
          {page.data.detailCta.description}
        </p>
        <a
          href={page.data.detailCta.href}
          class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg bg-accent-600 text-white hover:bg-accent-700 transition-colors"
        >
          {page.data.detailCta.label}
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
